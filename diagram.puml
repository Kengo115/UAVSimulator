  package "operator.route" #F9EBEA {

    interface RouteSearcher {
      +search(Client, int) : void
    }

    abstract class AbstractPhysarumSolverRouteSearcher {
      #serverController : ServerController
      #adjMatrix : int[][]
      #link : Link[][]
      #beaconCluster : BeaconCluster
      #node : int
      #Q_Kirchhoff : double[]
      #P_tubePressure : double[]
      #D_tubeThickness_deltaT : double[][]
      #pressureCoefficient : double[][]
      #Q_tubeFlow_sigmoidOutput : double[][]
      #tubeFlow : int[][]
      +search(Client, int) : void
      #{abstract} updateTubeThickness(int) : void
      #{abstract} solvePressureEquation(...) : int
      #runUAVFlowRedis(int,int,int,Client) : void
      #explorePath(...) : int
      #explorePathGreedy(...) : boolean
    }

    class DijkstraRouteSearcher {
      -serverController : ServerController
      -adjMatrix : int[][]
      -link : Link[][]
      -beaconCluster : BeaconCluster
      -node : int
      +search(Client, int) : void
      -dijkstra(Client) : int[]
      -runUAVFlowRedis(Client, int[], int) : void
    }

    class PhysarumSolverRouteSearcher {
      +updateTubeThickness(int) : void
      +solvePressureEquation(...) : int
      +getRouteRecordTag() : String
    }

    class ExtendedPhysarumSolverRouteSearcher {
      #disconnectedLinkCount : int
      +updateTubeThickness(int) : void
      +solvePressureEquation(...) : int
      #disconnectZeroCapacityLinks() : void
      #restoreDisconnectedLinks() : void
    }

    class HybridPhysarumSolverRouteSearcher {
      -currentFlow : double
      -requestedFlow : double
      -stableIterationCount : int
      +search(Client, int) : void
      -calculateSourcePressureScore() : double
      -applyUAVFlowReduction(double, String) : boolean
    }

    class BinaryExtendedPhysarumSolverRouteSearcher {
      +search(Client, int) : void
      -testFlowStability(Client, double, double) : FlowTestResult
      -performDynamicBinarySearchEPS(Client, double) : void
    }

    class BisectionalPressureGuidedEPSRouteSearcher {
      +search(Client, int) : void
      -testFlowStability(Client, double, double) : FlowTestResult
    }

    class StepControlledPressureGuidedEPSRouteSearcher {
      +search(Client, int) : void
      -calculateSourcePressureScore() : double
      -applyUAVFlowReduction(double, String) : boolean
    }

    class SolverFailedException {
      -clientId : int
      -iteration : int
      -searcherType : String
      +getClientId() : int
      +getSearcherType() : String
      +getReason() : String
    }
  }


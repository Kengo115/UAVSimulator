  ' =========================================================
  '  RELATIONSHIPS
  ' =========================================================

  ' ---- shared.item 内部 ----
  BeaconCluster "1" *-- "1..*" Beacon : contains >
  Beacon "1" o-- "0..*" Uav : waitingUavList >
  Flow "1" *-- "1..*" Uav : uavList >
  Flow "n" --> "1" Beacon : source
  Flow "n" --> "1" Beacon : destination
  Uav "1" *-- "1" UAVFlightTimer
  Uav "1" *-- "1" UAVWaitingTimer
  Uav "n" --> "1" Beacon : Source
  Uav "n" --> "1" Beacon : Destination
  Uav "n" --> "0..1" Link : flyingLink
  Link "n" --> "1" Beacon : beacon1
  Link "n" --> "1" Beacon : beacon2
  UAVFlightTimer ..> Uav : callback
  UAVWaitingTimer ..> Uav : callback

  ' ---- shared.client ----
  Client "1" *-- "1" Flow
  ClientController "1" *-- "0..*" Client : manages >
  ClientController "1" *-- "1" ClientTimer

  ' ---- shared.network ----
  TopologyFileReader ..> TopologyData : creates >
  TopologyData "1" *-- "1..*" NodeInfo
  TopologyData "1" *-- "1..*" LinkInfo
  BeaconCluster ..> TopologyData : constructs from
  NetworkTopologyManager ..> Link : initialises
  NetworkTopologyManager ..> BeaconCluster : uses
  NetworkTopologyManager ..> TopologyData : reads

  ' ---- shared.redis / util ----
  RedisConnectionManager ..> LogManager : uses
  ClientTimeManager ..> LogManager : uses
  LinkStatusRecorder ..> LogManager : uses
  Link117DebugLogger ..> LogManager : uses
  EPSSavePoint ..> Link : saves/restores
  EPSSavePoint ..> LogManager : uses

  ' ---- operator.route 継承 ----
  DijkstraRouteSearcher ..|> RouteSearcher
  AbstractPhysarumSolverRouteSearcher ..|> RouteSearcher
  PhysarumSolverRouteSearcher --|> AbstractPhysarumSolverRouteSearcher
  ExtendedPhysarumSolverRouteSearcher --|> AbstractPhysarumSolverRouteSearcher
  HybridPhysarumSolverRouteSearcher --|> ExtendedPhysarumSolverRouteSearcher
  BinaryExtendedPhysarumSolverRouteSearcher --|> ExtendedPhysarumSolverRouteSearcher
  BisectionalPressureGuidedEPSRouteSearcher --|> ExtendedPhysarumSolverRouteSearcher
  StepControlledPressureGuidedEPSRouteSearcher --|> ExtendedPhysarumSolverRouteSearcher
  SolverFailedException --|> RuntimeException

  ' ---- operator.route 依存 ----
  AbstractPhysarumSolverRouteSearcher "n" --> "1" ServerController : serverController
  AbstractPhysarumSolverRouteSearcher "n" --> "1" BeaconCluster : beaconCluster
  AbstractPhysarumSolverRouteSearcher ..> EPSSavePoint : uses
  AbstractPhysarumSolverRouteSearcher ..> BiCGSTABSolver : uses
  AbstractPhysarumSolverRouteSearcher ..> ICCGSolver : uses
  AbstractPhysarumSolverRouteSearcher ..> LogManager : uses
  DijkstraRouteSearcher "n" --> "1" ServerController : serverController
  DijkstraRouteSearcher "n" --> "1" BeaconCluster : beaconCluster

  ' ---- operator.controller ----
  ServerController "1" *-- "7" RouteSearcher : searchers
  ServerController ..> Link : link[][]
  ServerController ..> BeaconCluster : beaconCluster
  ServerController ..> Client : processes
